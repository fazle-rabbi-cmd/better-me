# Application Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/better_me_db?schema=public"

# Authentication JWT Secrets (Change these in production!)
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# AI Integration Configuration (Optional / Fallback Ready)
AI_PROVIDER="gemini"
AI_API_KEY=""