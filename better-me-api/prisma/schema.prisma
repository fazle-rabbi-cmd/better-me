datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum HabitType {
  BINARY     // e.g., Meditate, Read
  QUANTITY   // e.g., Drink 2L water, Read 20 pages
  DURATION   // e.g., Study for 60 minutes
  AVOIDANCE  // e.g., No social media
}

enum FrequencyType {
  DAILY
  WEEKDAYS
  WEEKENDS
  CUSTOM
}

enum CompletionStatus {
  COMPLETED
  PARTIAL
  SKIPPED
  MISSED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String
  role          Role      @default(USER)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  profile       Profile?
  sessions      Session[]
  habits        Habit[]

  @@index([email])
  @@map("users")
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  firstName            String?
  lastName             String?
  timezone             String   @default("UTC")
  locale               String   @default("en-US")
  notificationEnabled  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Habit {
  id          String        @id @default(uuid())
  userId      String
  title       String
  description String?
  type        HabitType     @default(BINARY)
  frequency   FrequencyType @default(DAILY)
  targetValue Float         @default(1.0) // e.g., 2 liters, 30 minutes
  unit        String?       // e.g., "pages", "minutes", "liters"
  isArchived  Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule    HabitSchedule?
  completions HabitCompletion[]

  @@index([userId])
  @@map("habits")
}

model HabitSchedule {
  id          String   @id @default(uuid())
  habitId     String   @unique
  daysOfWeek  Int[]    // Array of days (0 = Sunday, 1 = Monday, etc.)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@map("habit_schedules")
}

model HabitCompletion {
  id          String           @id @default(uuid())
  habitId     String
  date        DateTime         // Stored as date only (UTC midnight normalized)
  status      CompletionStatus @default(COMPLETED)
  actualValue Float?           // Recorded amount (e.g., read 15 pages out of 20)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  habit       Habit            @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date]) // Ensures a habit can only have one completion record per day (Idempotent!)
  @@index([habitId, date])
  @@map("habit_completions")
}